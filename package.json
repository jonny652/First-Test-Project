{
  "name": "first-test-project",
  "version": "1.0.0",
  "description": "first automation project",
  "license": "ISC",
  "author": "jonny",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "codegen": "playwright codegen https://source.thenbs.com",
    "test:ui": "playwright test --ui --project=\"Microsoft Edge\"",
    "test:headless": "playwright test --project=\"Microsoft Edge\"",
    "test:all": "playwright test",
    "test:bdd": "node features/support/run-bdd.js",
    "test:bdd:report": "node features/support/run-bdd.js",
    "log:ci-bugs:playwright": "node scripts/log-ci-bugs.js playwright",
    "log:ci-bugs:cucumber": "node scripts/log-ci-bugs.js cucumber",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.202",
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/pngjs": "^6.0.5",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "axe-html-reporter": "^2.2.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix"
  }
